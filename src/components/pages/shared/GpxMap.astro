---
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";

interface Props {
	gpxUrl: string;
}

const { gpxUrl } = Astro.props;
const kmUnit = i18n(I18nKey.sportsKm);
---

<div
  class="gpx-map rounded-xl overflow-hidden border border-(--line-divider) relative"
  data-gpx-url={gpxUrl}
  data-km-unit={kmUnit}
>
  <div class="gpx-map-canvas w-full h-[360px] sm:h-[460px]"></div>
</div>

<style is:global>
  @import "leaflet/dist/leaflet.css";

  .gpx-map .leaflet-container {
    font-family: inherit;
  }

  /* 现代化缩放按钮：圆角胶囊 + 毛玻璃 */
  .gpx-map .leaflet-control-zoom {
    border: 1px solid rgb(0 0 0 / 0.08) !important;
    border-radius: 9999px !important;
    box-shadow: 0 4px 16px rgb(0 0 0 / 0.12) !important;
    overflow: hidden;
    background: rgb(255 255 255 / 0.72);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }
  .gpx-map .leaflet-control-zoom a {
    width: 36px !important;
    height: 36px !important;
    line-height: 34px !important;
    font-size: 20px !important;
    font-weight: 400;
    color: #374151 !important;
    background: transparent !important;
    border: none !important;
  }
  .gpx-map .leaflet-control-zoom a:hover {
    background: rgb(0 0 0 / 0.06) !important;
    color: #111827 !important;
  }
  .gpx-map .leaflet-control-zoom-in {
    border-bottom: 1px solid rgb(0 0 0 / 0.06) !important;
  }

  /* 轨迹发光 */
  .gpx-track {
    filter: drop-shadow(0 0 5px rgb(0 0 0 / 0.2));
  }

  /* 暗色模式 */
  .gpx-map-dark .leaflet-tile-pane {
    filter: invert(1) hue-rotate(180deg) brightness(0.95) contrast(0.9);
  }
  .gpx-map-dark .leaflet-control-zoom {
    background: rgb(24 24 27 / 0.72);
    border-color: rgb(255 255 255 / 0.12);
  }
  .gpx-map-dark .leaflet-control-zoom a {
    color: #e5e7eb !important;
  }
  .gpx-map-dark .leaflet-control-zoom a:hover {
    background: rgb(255 255 255 / 0.1) !important;
    color: #fff !important;
  }
  .gpx-map-dark .leaflet-control-zoom-in {
    border-bottom-color: rgb(255 255 255 / 0.1) !important;
  }
</style>

<script>
  // 瓦片地址：默认高德（国内加载快）；如想换 OpenStreetMap，改 tileUrl 即可
  const tileUrl =
    "https://webrd0{s}.is.autonavi.com/appmaptile?lang=zh_cn&size=1&scale=1&style=8&x={x}&y={y}&z={z}";
  const subdomains = ["1", "2", "3", "4"];
  const attribution = "&copy; 高德地图";

  // 两点间距离（米，Haversine）
  function distanceMeters(a: [number, number], b: [number, number]) {
    const R = 6371000;
    const toRad = (d: number) => (d * Math.PI) / 180;
    const dLat = toRad(b[0] - a[0]);
    const dLon = toRad(b[1] - a[1]);
    const la1 = toRad(a[0]);
    const la2 = toRad(b[0]);
    const h =
      Math.sin(dLat / 2) ** 2 +
      Math.cos(la1) * Math.cos(la2) * Math.sin(dLon / 2) ** 2;
    return 2 * R * Math.asin(Math.sqrt(h));
  }

  async function renderMap(el: HTMLElement) {
    const url = el.dataset.gpxUrl;
    const kmUnit = el.dataset.kmUnit || "km";
    if (!url) return;

    const resp = await fetch(url);
    if (!resp.ok) return;
    const text = await resp.text();
    const doc = new DOMParser().parseFromString(text, "application/xml");

    const points: Array<[number, number]> = [];
    doc.querySelectorAll("trkpt").forEach((p) => {
      const lat = parseFloat(p.getAttribute("lat") || "");
      const lon = parseFloat(p.getAttribute("lon") || "");
      if (!Number.isNaN(lat) && !Number.isNaN(lon)) points.push([lat, lon]);
    });

    const canvas = el.querySelector<HTMLElement>(".gpx-map-canvas");
    if (!canvas || points.length < 2) return;

    const L = await import("leaflet");

    // 暗色模式适配（跟随主题切换）
    const applyDark = () =>
      el.classList.toggle(
        "gpx-map-dark",
        document.documentElement.classList.contains("dark"),
      );
    applyDark();
    new MutationObserver(applyDark).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["class"],
    });

    const map = L.map(canvas, {
      scrollWheelZoom: false,
      attributionControl: true,
    });
    L.tileLayer(tileUrl, {
      subdomains,
      attribution,
      maxZoom: 19,
    }).addTo(map);

    // 轨迹颜色跟随站点主色
    const primary =
      getComputedStyle(document.documentElement)
        .getPropertyValue("--primary")
        .trim() || "#e85d75";

    L.polyline(points, {
      color: primary,
      weight: 4,
      opacity: 0.95,
      lineCap: "round",
      lineJoin: "round",
      className: "gpx-track",
    }).addTo(map);

    map.fitBounds(points as [number, number][], { padding: [24, 24] });

    // 距离标签
    let dist = 0;
    for (let i = 1; i < points.length; i++) {
      dist += distanceMeters(points[i - 1], points[i]);
    }
    const km = (dist / 1000).toFixed(1);
    const label = document.createElement("div");
    label.className =
      "absolute top-3 right-3 z-[500] rounded-md px-2.5 py-1 text-xs font-medium bg-black/60 text-white backdrop-blur-sm pointer-events-none";
    label.textContent = `${km}${kmUnit}`;
    el.appendChild(label);
  }

  // 渲染页面上所有轨迹
  async function init() {
    const maps = document.querySelectorAll<HTMLElement>(".gpx-map");
    for (const el of maps) {
      try {
        await renderMap(el);
      } catch (e) {
        console.error("GPX map render failed", e);
      }
    }
  }

  init();
  document.addEventListener("astro:page-load", init);
</script>
