---
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import { quoteConfig } from "@/config/quoteConfig";
import type { WidgetComponentConfig } from "@/types/config";

interface Props {
	class?: string;
	style?: string;
	widgetConfig?: WidgetComponentConfig;
}

const { class: className, style, widgetConfig } = Astro.props;

const showTitle = widgetConfig?.showTitle !== false;

// 服务端渲染一条本地名言作为首屏占位 / API 失败兜底
const quotes = quoteConfig.quotes || [];
const today = new Date();
const dateStr = today.toISOString().split("T")[0];
const seed = dateStr
	.split("")
	.reduce((acc, char) => acc + char.charCodeAt(0), 0);
const randomIndex = quotes.length > 0 ? seed % quotes.length : 0;
const quote = quotes[randomIndex] || { text: "暂无名言", author: "" };
---

<WidgetLayout
  name="✨ 今日一言"
  showTitle={showTitle}
  id="quote-of-the-day"
  class={className}
  style={style}
>
	<div class="quote-content">
		<blockquote class="quote-text">
			<span class="quote-mark">"</span>
			<span data-hitokoto-text>{quote.text}</span>
			<span class="quote-mark">"</span>
		</blockquote>
		<cite class="quote-author">—— <span data-hitokoto-author>{quote.author}</span></cite>
	</div>
</WidgetLayout>

<style>
	.quote-content {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		padding: 0.5rem 0;
	}

	.quote-text {
		position: relative;
		font-style: italic;
		font-size: 0.9rem;
		line-height: 1.6;
		padding: 0 0.5rem;
		margin: 0;
	}

	.quote-mark {
		font-size: 1.5rem;
		line-height: 0;
		vertical-align: middle;
		color: var(--primary);
		opacity: 0.6;
		font-family: Georgia, serif;
	}

	.quote-author {
		display: block;
		text-align: right;
		font-size: 0.75rem;
		color: var(--content-meta);
		font-style: normal;
		margin-top: 0.25rem;
	}

	/* 悬停效果 */
	.quote-content:hover .quote-text {
		color: var(--primary);
		transition: color 0.2s ease;
	}
</style>

<script is:inline>
	// Hitokoto 一言 API：https://v1.hitokoto.cn/
	// 每天缓存一句，当天保持不变；请求失败时保留服务端渲染的本地名言兜底
	(function () {
		const API_URL = "https://v1.hitokoto.cn/?encode=json&c=d&c=i";
		const CACHE_KEY = "hitokoto_cache";
		const today = new Date().toISOString().split("T")[0];

		function setQuote(text, author) {
			document.querySelectorAll("[data-hitokoto-text]").forEach((el) => {
				if (text) el.textContent = text;
			});
			document.querySelectorAll("[data-hitokoto-author]").forEach((el) => {
				if (author) el.textContent = author;
			});
		}

		// 命中当天缓存则直接使用，不再请求
		try {
			const cached = JSON.parse(localStorage.getItem(CACHE_KEY) || "null");
			if (cached && cached.date === today && cached.hitokoto) {
				setQuote(cached.hitokoto, cached.author || "");
				return;
			}
		} catch {}

		fetch(API_URL)
			.then((res) => {
				if (!res.ok) throw new Error(`请求失败: ${res.status}`);
				return res.json();
			})
			.then((data) => {
				if (!data || !data.hitokoto) return;
				const author = data.from_who || data.from || "";
				setQuote(data.hitokoto, author);
				try {
					localStorage.setItem(
						CACHE_KEY,
						JSON.stringify({
							date: today,
							hitokoto: data.hitokoto,
							author,
						}),
					);
				} catch {}
			})
			.catch(() => {
				// 失败时保留服务端渲染的本地名言
			});
	})();
</script>
