---
import { Icon } from "astro-icon/components";
import { getCollection, render } from "astro:content";
import { siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { formatDateI18n } from "@/utils/date-utils";
import { fmtDurationSec, getTypeIcon } from "@/utils/sports-utils";
import { url } from "@/utils/url-utils";

// 检查页面是否启用
if (!siteConfig.pages.sports) {
	return Astro.redirect("/404/");
}

const title = i18n(I18nKey.sports);
const description = i18n(I18nKey.sportsDescription);

// 读取运动记录并按时间倒序
const records = (await getCollection("sports")).sort(
	(a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

// 渲染每条记录的备注
const noteContents = new Map<string, any>();
for (const r of records) {
	const { Content } = await render(r);
	noteContents.set(r.id, Content);
}

// 汇总统计
const totalSessions = records.length;
const totalSeconds = records.reduce((s, r) => s + (r.data.duration ?? 0), 0);
const totalDistance = records.reduce((s, r) => s + (r.data.distance ?? 0), 0);
const totalCalories = records.reduce((s, r) => s + (r.data.calories ?? 0), 0);

// 按月份分组
const localeMap: Record<string, string> = {
	zh_CN: "zh-CN",
	zh_TW: "zh-TW",
	en: "en-US",
	ja: "ja-JP",
	ru: "ru-RU",
};
const locale = localeMap[siteConfig.lang || "en"] || "en-US";
const monthGroups = new Map<string, typeof records>();
for (const r of records) {
	const key = `${r.data.date.getFullYear()}-${String(r.data.date.getMonth() + 1).padStart(2, "0")}`;
	if (!monthGroups.has(key)) monthGroups.set(key, []);
	monthGroups.get(key)!.push(r);
}
const monthLabel = (key: string) => {
	const [y, m] = key.split("-").map(Number);
	return new Date(y, m - 1, 1).toLocaleDateString(locale, {
		year: "numeric",
		month: "long",
	});
};

const stats = [
	{
		label: i18n(I18nKey.sportsTotalSessions),
		value: String(totalSessions),
		icon: "material-symbols:flag",
	},
	{
		label: i18n(I18nKey.sportsTotalDuration),
		value: fmtDurationSec(totalSeconds),
		icon: "material-symbols:schedule",
	},
	{
		label: i18n(I18nKey.sportsTotalDistance),
		value: `${totalDistance.toFixed(1)}${i18n(I18nKey.sportsKm)}`,
		icon: "material-symbols:route",
	},
	{
		label: i18n(I18nKey.sportsTotalCalories),
		value: `${Math.round(totalCalories)}${i18n(I18nKey.sportsKcal)}`,
		icon: "material-symbols:local-fire-department",
	},
];
---

<MainGridLayout title={title} description={description}>
  <div
    class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32"
  >
    <div class="card-base z-10 px-9 py-6 relative w-full">
      <!-- 页面标题和描述 -->
      <div class="mb-6">
        <div class="flex items-center gap-3 mb-3">
          <div
            class="h-8 w-8 rounded-lg bg-(--primary) flex items-center justify-center text-white dark:text-black/70"
          >
            <Icon name="material-symbols:directions-run" class="text-[1.5rem]" />
          </div>
          <div class="text-3xl font-bold text-neutral-900 dark:text-neutral-100">
            {title}
          </div>
        </div>
        {description && (
          <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed mb-4">
            {description}
          </p>
        )}
      </div>

      <!-- 统计卡片 -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
        {stats.map((s) => (
          <div
            class="rounded-xl border border-(--line-divider) p-4 text-center"
          >
            <Icon name={s.icon} class="text-[1.75rem] text-(--primary) mx-auto mb-2" />
            <div
              class="text-xl font-bold text-neutral-900 dark:text-neutral-100 leading-tight"
            >
              {s.value}
            </div>
            <div class="text-sm text-(--content-meta) mt-1">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- 时间线 -->
  {records.length > 0 ? (
    <div class="card-base z-10 px-9 py-6 relative w-full mt-4">
      {[...monthGroups.entries()].map(([month, list]) => (
        <div class="mb-8 last:mb-0">
          <div class="flex items-center gap-3 mb-5">
            <span class="text-lg font-bold text-neutral-900 dark:text-neutral-100">
              {monthLabel(month)}
            </span>
            <span class="h-px flex-1 bg-(--line-divider)"></span>
          </div>

          <div class="relative">
            <!-- 时间轴竖线 -->
            <div
              class="absolute left-4 top-2 bottom-2 w-px bg-(--line-divider)"
            ></div>
            <div class="space-y-7">
              {list.map((r) => {
                const Note = noteContents.get(r.id);
                return (
                <div class="relative pl-12">
                  <a
                    href={url(`/sports/${r.id}/`)}
                    class="block rounded-xl -m-1 p-1 transition-colors duration-200 hover:bg-(--btn-regular-bg)/60"
                  >
                  <!-- 时间轴节点 -->
                  <div
                    class="absolute left-0 top-0 h-8 w-8 rounded-full bg-(--primary) flex items-center justify-center text-white dark:text-black/70"
                  >
                    <Icon name={getTypeIcon(r.data.type)} class="text-[1.1rem]" />
                  </div>

                  <div>
                    <div class="flex flex-wrap items-center gap-x-3 gap-y-1 mb-1.5">
                      <span class="text-sm text-(--content-meta)">
                        {formatDateI18n(r.data.date)}
                      </span>
                      <span class="font-bold text-neutral-900 dark:text-neutral-100">
                        {r.data.type}
                      </span>
                    </div>

                    <div class="flex flex-wrap gap-2 mb-2">
                      {r.data.duration > 0 && (
                        <span
                          class="inline-flex items-center gap-1 rounded-md px-2 py-0.5 text-xs bg-(--btn-regular-bg) text-(--content-meta)"
                        >
                          <Icon name="material-symbols:schedule" class="text-sm" />
                          {fmtDurationSec(r.data.duration)}
                        </span>
                      )}
                      {r.data.distance > 0 && (
                        <span
                          class="inline-flex items-center gap-1 rounded-md px-2 py-0.5 text-xs bg-(--btn-regular-bg) text-(--content-meta)"
                        >
                          <Icon name="material-symbols:straighten" class="text-sm" />
                          {r.data.distance}{i18n(I18nKey.sportsKm)}
                        </span>
                      )}
                      {r.data.calories > 0 && (
                        <span
                          class="inline-flex items-center gap-1 rounded-md px-2 py-0.5 text-xs bg-(--btn-regular-bg) text-(--content-meta)"
                        >
                          <Icon name="material-symbols:local-fire-department" class="text-sm" />
                          {r.data.calories}{i18n(I18nKey.sportsKcal)}
                        </span>
                      )}
                    </div>

                    {r.body?.trim() && (
                      <div class="text-sm text-neutral-600 dark:text-neutral-400">
                        <Note />
                      </div>
                    )}
                  </div>
                  </a>
                </div>
                );
              })}
            </div>
          </div>
        </div>
      ))}
    </div>
  ) : (
    <div class="card-base p-8 mb-6 relative overflow-hidden mt-4">
      <div class="text-center py-16 text-(--content-meta)">
        <div
          class="w-16 h-16 mx-auto mb-4 rounded-full bg-(--btn-regular-bg) flex items-center justify-center"
        >
          <Icon
            name="material-symbols:directions-run"
            class="w-8 h-8 text-(--primary)"
          />
        </div>
        <p class="text-base">{i18n(I18nKey.sportsNoRecords)}</p>
      </div>
    </div>
  )}
</MainGridLayout>
